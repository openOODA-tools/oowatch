// # Theme and Terminal Renderer - Color Palettes and Entity Styling
//
// Logline: Hydrates terminal palette from ~/.openooda/theme.oot for continuous watch output.
//
// Setup: Requires FsReadCap and EnvCap. Operates with zero ambient authority.
//
// Beats:
//   1. Resolve theme name from OODA_THEME or ~/.openooda/theme.oot with fallback.
//   2. Provide theme-specific ANSI codes for headers, borders, and diff highlights.
//   3. Provide terminal control sequences for clearing screen and repositioning cursor.

import "std/fs/process/env.oo";

pub fn ansi_esc() -> String {
    return bytes_to_str(bytes_push(bytes_new(), 27));
}

pub fn term_reset() -> String {
    return ansi_esc() + "[0m";
}

pub fn term_clear_screen() -> String {
    return ansi_esc() + "[2J" + ansi_esc() + "[H";
}

pub fn term_invert() -> String {
    return ansi_esc() + "[7m";
}

pub fn parse_theme_val(line: String, key: String) -> String {
    let trimmed: String = str_trim(line);
    if !str_starts_with(trimmed, key) { return ""; }
    let rest: String = str_trim(str_slice(trimmed, chars_len(key), chars_len(trimmed)));
    if !str_starts_with(rest, "=") { return ""; }
    let mut val: String = str_trim(str_slice(rest, 1, chars_len(rest)));
    if str_starts_with(val, "\"") && str_ends_with(val, "\"") {
        let n: Int = chars_len(val);
        if n >= 2 { val = str_slice(val, 1, n - 1); }
    }
    return val;
}

pub fn parse_theme_key(content: String, key: String) -> String {
    let n: Int = chars_len(content);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(content, i);
        if c == "\n" {
            let v: String = parse_theme_val(cur, key);
            if v != "" { return v; }
            cur = "";
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if cur != "" {
        let v: String = parse_theme_val(cur, key);
        if v != "" { return v; }
    }
    return "";
}

pub fn resolve_watch_theme(fs: &FsReadCap, env: &EnvCap) -> String {
    let env_t: Result[String, String] = env_get(env, "OODA_THEME");
    if env_t.is_ok() {
        let t: String = match env_t { Ok(s) => s, Err(_) => "" };
        if t != "" { return t; }
    }
    let env_home: Result[String, String] = env_get(env, "OODA_HOME");
    let mut home: String = match env_home { Ok(s) => s, Err(_) => "" };
    if home == "" {
        let env_w: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
        home = match env_w { Ok(s) => s, Err(_) => "" };
    }
    if home == "" {
        let env_h: Result[String, String] = env_get(env, "HOME");
        home = match env_h { Ok(s) => s, Err(_) => "" };
    }
    let p: String = if str_ends_with(home, "/") { home + ".openooda/theme.oot" } else { home + "/.openooda/theme.oot" };
    let r: Result[String, String] = read_file(fs, p);
    if r.is_err() { return "classic/1982"; }
    let content: String = match r { Ok(s) => s, Err(_) => "" };
    let t: String = parse_theme_key(content, "theme");
    return if t != "" { t } else { "classic/1982" };
}

pub fn theme_header_color(theme: String) -> String {
    let esc: String = ansi_esc();
    if str_starts_with(theme, "dracula") { return esc + "[1;35m"; }
    if str_starts_with(theme, "nord") { return esc + "[1;36m"; }
    if str_starts_with(theme, "cyberpunk") { return esc + "[1;33m"; }
    return esc + "[1;32m";
}

pub fn theme_diff_color(theme: String) -> String {
    let esc: String = ansi_esc();
    if str_starts_with(theme, "dracula") { return esc + "[1;33;7m"; }
    if str_starts_with(theme, "nord") { return esc + "[1;32;7m"; }
    if str_starts_with(theme, "cyberpunk") { return esc + "[1;35;7m"; }
    return esc + "[1;33;7m";
}

pub fn theme_border_color(theme: String) -> String {
    let esc: String = ansi_esc();
    return esc + "[2;37m";
}
